# Copy the variable names into your own .env and fill in values.
# Never commit .env to Git.

API_FOOTBALL_KEY=your_api_football_key

POSTGRES_USER=scoutiq
POSTGRES_PASSWORD=change_me
POSTGRES_DB=scoutiq

# Used when running Python on Windows directly (outside Docker): note port 5433
DATABASE_URL=postgresql+psycopg://scoutiq:change_me@localhost:5433/scoutiq

# Signs login tokens. At least 32 characters; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=paste_a_long_random_value_here
